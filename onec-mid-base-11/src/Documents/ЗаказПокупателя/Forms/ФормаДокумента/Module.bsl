#Область СлужебныеПроцедурыИФункции

// ИЛ. Обработчик изменения программно добавленного
// поля согласованной скидки.
&НаКлиенте
Процедура ИЛ_СогласованнаяСкидкаПриИзменении(Элемент)
	
	// ИЛ. Скидка в документе не может превышать 100 процентов.
	Если Объект.ИЛ_СогласованнаяСкидка > 100 Тогда
		
		Объект.ИЛ_СогласованнаяСкидка = 100;
		
		// ИЛ. Информируем пользователя о корректировке значения скидки.
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Согласованная скидка не может превышать 100 %. "
			+ "Установлено значение 100 %.";
		Сообщение.Сообщить();
		
	КонецЕсли;
	
	// ИЛ. Применяем согласованную скидку ко всем строкам
	// товаров и услуг и пересчитываем суммы.
	ИЛ_ПрименитьСогласованнуюСкидку();
	
КонецПроцедуры


// ИЛ. Применяет значение согласованной скидки
// ко всем строкам табличных частей документа.
&НаКлиенте
Процедура ИЛ_ПрименитьСогласованнуюСкидку()
	
	// ИЛ. Устанавливаем скидку для всех строк товаров.
	Для Каждого СтрокаТовара Из Объект.Товары Цикл
		
		СтрокаТовара.Скидка = Объект.ИЛ_СогласованнаяСкидка;
		
		// ИЛ. Используем существующий механизм расчета суммы строки.
		РассчитатьСуммуСтроки(СтрокаТовара);
		
	КонецЦикла;
	
	// ИЛ. Устанавливаем скидку для всех строк услуг.
	Для Каждого СтрокаУслуги Из Объект.Услуги Цикл
		
		СтрокаУслуги.Скидка = Объект.ИЛ_СогласованнаяСкидка;
		
		// ИЛ. Используем существующий механизм расчета суммы строки.
		РассчитатьСуммуСтроки(СтрокаУслуги);
		
	КонецЦикла;
	
	// ИЛ. После изменения строк пересчитываем общую сумму документа.
	РассчитатьСуммуДокумента();
	
КонецПроцедуры


// ИЛ. Программно добавляем поле согласованной скидки
// в правую часть шапки формы документа.
&НаСервере
Процедура ИЛ_ДобавитьПолеСогласованнойСкидки()
	
	// ИЛ. Создаем новый элемент формы.
	ЭлементСкидки = Элементы.Добавить(
		"ИЛ_СогласованнаяСкидка",
		Тип("ПолеФормы"),
		Элементы.ГруппаШапкаПраво);
	
	// ИЛ. Элемент используется как поле ввода.
	ЭлементСкидки.Вид = ВидПоляФормы.ПолеВвода;
	
	// ИЛ. Связываем элемент формы с реквизитом документа.
	ЭлементСкидки.ПутьКДанным =
		"Объект.ИЛ_СогласованнаяСкидка";
	
	// ИЛ. Устанавливаем заголовок поля.
	ЭлементСкидки.Заголовок =
		"Согласованная скидка";
	
	// ИЛ. Назначаем обработчик изменения значения скидки.
	ЭлементСкидки.УстановитьДействие(
		"ПриИзменении",
		"ИЛ_СогласованнаяСкидкаПриИзменении");
	
КонецПроцедуры


&НаКлиенте
Процедура РассчитатьСуммуСтроки(ТекущиеДанные)
	
	КоэффициентСкидки = 1 - ТекущиеДанные.Скидка / 100;
	ТекущиеДанные.Сумма =
		ТекущиеДанные.Цена
		* ТекущиеДанные.Количество
		* КоэффициентСкидки;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуДокумента()
	
	Объект.СуммаДокумента =
		Объект.Товары.Итог("Сумма")
		+ Объект.Услуги.Итог("Сумма");
	
КонецПроцедуры


